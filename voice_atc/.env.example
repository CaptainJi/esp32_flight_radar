# 国内控制台申请的 Key → 用 api.minimaxi.com
# 国际控制台申请的 Key → 用 api.minimax.io
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_CHAT_MODEL=MiniMax-M2.5
MINIMAX_TTS_MODEL=speech-2.6-turbo
MINIMAX_VOICE_ID=male-qn-qingse
# 可选：GroupId（部分旧接口需要）
MINIMAX_GROUP_ID=
# 监听
VOICE_ATC_HOST=0.0.0.0
VOICE_ATC_PORT=8765
# 无 Key 时返回假回复，方便先联调 UI
VOICE_ATC_MOCK=0
