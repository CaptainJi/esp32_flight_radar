# 火山方舟（Chat）
ARK_API_KEY=
ARK_ENDPOINT_ID=
ARK_BASE_URL=https://ark.cn-beijing.volces.com
# disabled|enabled|auto — 电台短句建议 disabled，避免深度思考拖垮超时
ARK_THINKING=disabled
ARK_MAX_TOKENS=256

# 豆包全双工智能对话（Duplex WebSocket）
VOICE_API_KEY=
VOICE_WS_URL=wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue
VOICE_MODEL=1.2.6.0
VOICE_SPEAKER=zh_male_yunzhou_jupiter_bigtts
# 英文 TTS 音色（lang=en 时使用）
VOICE_SPEAKER_EN=en_male_adam_mars_bigtts
# 可选：部分控制台仍要求 AppId
VOICE_APP_ID=

# 后端模式：auto|hybrid|duplex|ark
# auto：同时有方舟+语音时走 hybrid（方舟文本 + duplex TTS）
VOICE_BACKEND=auto

# 音频后处理（服务端；默认关，板端 CALL 面板可开）
RADIO_FX=0
RADIO_FX_LEVEL=0.45
FLIGHT_BG=0
FLIGHT_BG_LEVEL=0.35

# 监听
VOICE_ATC_HOST=0.0.0.0
VOICE_ATC_PORT=18650
# 强制 MOCK（忽略已有 Key）
VOICE_ATC_MOCK=0
